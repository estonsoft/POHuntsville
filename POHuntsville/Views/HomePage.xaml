<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="POHuntsville.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:POHuntsville.Controls"
    xmlns:data="clr-namespace:POHuntsville"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:vm="clr-namespace:POHuntsville.ViewModels"
    Title="Profit Order"
    Background="#F5F7FB"
    NavigationPage.HasNavigationBar="False">

    <NavigationPage.TitleView>
        <StackLayout
            Orientation="Horizontal"
            Spacing="10"
            VerticalOptions="Center">

            <Label
                Padding="10,0,0,0"
                FontSize="16"
                Text="Profit Order"
                TextColor="White"
                VerticalTextAlignment="Center"/>
        </StackLayout>
    </NavigationPage.TitleView>

    <ContentPage.BindingContext>
        <vm:HomeViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BannerBackground">White</Color>
            <Color x:Key="Accent">#155EEF</Color>
            <Color x:Key="Ink">#172B4D</Color>
            <Color x:Key="MutedInk">#667085</Color>
            <Color x:Key="SurfaceStroke">#D9E2F2</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Shell.SearchHandler>
        <controls:MySearchHandler
            x:Name="SearchBox"
            Placeholder="Search Products"
            ShowsResults="false"/>
    </Shell.SearchHandler>

    <Grid Margin="{OnPlatform iOS='0,50,0,0', Android='0'}"
          SafeAreaEdges="{OnPlatform iOS='None', Android='All'}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0">
            <Border
                Margin="16,12,16,8"
                Background="White"
                HeightRequest="52"
                HorizontalOptions="Fill"
                Stroke="{StaticResource SurfaceStroke}"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="44,*,40">
                <ffimageloading:CachedImage
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    Source="menu_blue.png"
                    WidthRequest="28">
                    <ffimageloading:CachedImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped"/>
                    </ffimageloading:CachedImage.GestureRecognizers>
                </ffimageloading:CachedImage>
                <Entry
                    Grid.Column="1"
                    x:Name="SearchText"
                    ClearButtonVisibility="WhileEditing"
                    Completed="OnSearchTapped"
                    FontSize="14"
                    HorizontalOptions="Fill"
                    Placeholder="Search Products"
                    PlaceholderColor="{StaticResource MutedInk}"
                    TextChanged="Search_TextChanged"/>
                <Label
                    Grid.Column="2"
                    FontFamily="FontAwesomeFreeSolid"
                    FontSize="14"
                    HorizontalOptions="End"
                    Text="&#xF002;"
                    TextColor="{StaticResource Accent}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                </Grid>
            </Border>
            <BoxView
                BackgroundColor="{StaticResource SurfaceStroke}"
                HeightRequest="1"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"/>
        </StackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Fill"
                                 VerticalOptions="Start">
                <VerticalStackLayout
                    x:Name="lblLoginInfo"
                    Margin="16,18,16,12"
                    HeightRequest="52"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        x:Name="lblWelcome"
                        Margin="0,0,0,0"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Welcome"
                        TextColor="{StaticResource MutedInk}" />
                    <Label
                        x:Name="lblUserName"
                        Margin="0,-5,0,0"
                        FontAttributes="Bold"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Company Name"
                        TextColor="{StaticResource Ink}"
                        WidthRequest="-1"/>
                </VerticalStackLayout>
                <Border
                    Margin="16,0,16,14"
                    Padding="0"
                    Background="{StaticResource BannerBackground}"
                    HeightRequest="190"
                    Stroke="{StaticResource SurfaceStroke}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                        <ffimageloading:CachedImage
                            x:Name="BannerImage"
                            Aspect="AspectFit"
                            BackgroundColor="White"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"/>
                </Border>
                <Grid ColumnDefinitions="*, *"
                      HorizontalOptions="Fill"
                      ColumnSpacing="10"
                      Margin="10,5,10,5">

                    <!-- LEFT BUTTON: Past Purchases -->
                    <Border Grid.Column="0"
                            Padding="0"
                            Background="White"
                            HeightRequest="52"
                            HorizontalOptions="Fill"
                            Stroke="{StaticResource SurfaceStroke}"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <!-- Replaced inner Stack with Grid for precise icon alignment -->
                        <Grid ColumnDefinitions="45, *"
                              Padding="5,0,5,0"
                              VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPastPurchases"/>
                            </Grid.GestureRecognizers>

                            <Label Grid.Column="0"
                                   FontAttributes="Bold"
                                   FontFamily="FontAwesomeFreeSolid"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   Text="&#xF571;"
                                   TextColor="{StaticResource Accent}"/>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Margin="5,0,0,0">
                                <Label FontSize="12"
                                       FontAttributes="Bold"
                                       Text="Past Purchases"
                                       TextColor="{StaticResource Ink}"/>
                                <HorizontalStackLayout VerticalOptions="Center">
                                    <Label FontSize="10"
                                           Text="Reorder"
                                           TextColor="{StaticResource Accent}"
                                           VerticalOptions="Center"/>
                                    <Label Margin="5,0,0,0"
                                           FontAttributes="Bold"
                                           FontFamily="FontAwesomeFreeSolid"
                                           FontSize="10"
                                           Text="&#xF061;"
                                           TextColor="{StaticResource Accent}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- RIGHT BUTTON: Refresh Data -->
                    <Border Grid.Column="1"
                            Padding="0"
                            Background="White"
                            HeightRequest="52"
                            HorizontalOptions="Fill"
                            Stroke="{StaticResource SurfaceStroke}"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="45, *"
                              Padding="5,0,5,0"
                              VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRefresh"/>
                            </Grid.GestureRecognizers>

                            <Label Grid.Column="0"
                                   FontFamily="FontAwesomeFreeSolid"
                                   FontSize="32"
                                   Rotation="45"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   Text="↻"
                                   TextColor="{StaticResource Accent}"/>

                            <Label Grid.Column="1"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   Text="Refresh Data"
                                   TextColor="{StaticResource Ink}"
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid
                    Padding="16,14,16,0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <Label
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="Start Your Cart"
                        TextColor="{StaticResource Ink}"
                        VerticalOptions="Center"
                        WidthRequest="255"/>
                    <HorizontalStackLayout HorizontalOptions="End">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Fill"
                            Text="Shop All Items"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShopNow"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            Margin="20"
                            FontAttributes="Bold"
                            FontFamily="FontAwesomeFreeSolid"
                            FontSize="11"
                            HorizontalOptions="End"
                            Text="&#xF061;"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShopNow"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewItemsAll"/>
                    </Grid.GestureRecognizers>
                </Grid>
                <Grid
                    Padding="16,18,16,8"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                    <Label
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="Top Categories"
                        TextColor="{StaticResource Ink}"
                        VerticalOptions="Center"
                        WidthRequest="255"/>
                    <HorizontalStackLayout HorizontalOptions="End">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            HorizontalOptions="Fill"
                            Text="View All"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNewItemsAll"/>
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            Margin="20"
                            FontAttributes="Bold"
                            FontFamily="FontAwesomeFreeSolid"
                            FontSize="11"
                            HorizontalOptions="End"
                            Text="&#xF061;"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNewItemsAll"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewItemsAll"/>
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout
                    BindableLayout.ItemsSource="{Binding categories}"
                    HorizontalOptions="Start"
                    Padding="16,0,16,20"
                    Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="data:Category">
                            <controls:HomePageItems CategoryTapped="OnHomeCategoryTapped" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:CustomToolbar Grid.Row="2"
                                VerticalOptions="End"/>
        <controls:CustomAlertDialog
            x:Name="LoadingAlert"
            Title="App Sync In Progress"
            Grid.Row="0"
            ProgressPercentage="0"
            ProgressValue="0"
            Grid.RowSpan="2"
            IsLoading="True"
            IsVisible="False"
            Message="Please wait while we refreshing the App Data…"/>
    </Grid>
</ContentPage>
